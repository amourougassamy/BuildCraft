{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "**/.*", "**/node_modules/**", "tests/**", "tools/**", "package.json", "README.md"],
    "headers": [
      { "source": "vendor/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
